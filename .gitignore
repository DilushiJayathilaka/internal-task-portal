# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - .env.example is the deliberate exception: it's the template
# new clones need (see README "Getting started") and should never hold a
# real secret, only placeholders.
.env*
!.env.example

# vercel
.vercel

# local postgres data directory used for manual testing (see README)
/.pgdata/
pg.log

# typescript
*.tsbuildinfo
next-env.d.ts

# generated Prisma client (regenerated by `prisma generate`, run via postinstall)
/src/lib/generated/

# AI-agent instruction files - `next dev` auto-regenerates these locally
# whenever it detects an AI coding agent and the file is missing; ignored
# so that doesn't quietly resurface them for commit.
/AGENTS.md
/CLAUDE.md
