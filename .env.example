# Copy this file to .env and fill in real values before running the app.

# PostgreSQL connection string.
# Matches the docker-compose.yml service by default - change if you point
# at a different Postgres instance (e.g. Neon, Supabase, RDS).
DATABASE_URL="postgresql://postgres:portal@localhost:5432/portal?schema=public"

# Secret used to sign session JWTs (see lib/session.ts).
# Generate one with: openssl rand -base64 32
# Never reuse this value across environments.
SESSION_SECRET="replace-with-a-long-random-string"

# Vercel Blob token for evidence document uploads (see lib/blob.ts).
# On Vercel: Project -> Storage -> Create Database -> Blob, then copy the
# BLOB_READ_WRITE_TOKEN it generates
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_store_id_and_token_here"
